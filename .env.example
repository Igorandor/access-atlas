# Fixed upstream; users cannot redirect the proxy to arbitrary hosts.
IRIS_URL=http://127.0.0.1:52780
# Stable, unique deployment label used to prevent accidental cross-instance comparisons.
IRIS_INSTANCE_ID=atlas-local
PORT=3200
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:5174
# Set true when served behind HTTPS.
COOKIE_SECURE=false
